      "source": [
        "#Inputs\n",
        "x1 = 2\n",
        "x2 = 3\n",
        "\n",
        "#weights\n",
        "w1 = 0.5\n",
        "w2 = 0.2\n",
        "\n",
        "#Bias\n",
        "b = 0.1\n",
        "\n",
        "#weighted sum\n",
        "z = (w1 * w2) + (x2 * w2) + b\n",
        "\n",
        "#activation function\n",
        "def relu(z):\n",
        "    return max(0,z)\n",
        "\n",
        "\n",
        "# final prediction\n",
        "y_pred = relu(z)\n",
        "\n",
        "print(\"weighted sum:\", z)\n",
        "print(\"Neuron Output:\", y_pred)\n"
      ]
    },
