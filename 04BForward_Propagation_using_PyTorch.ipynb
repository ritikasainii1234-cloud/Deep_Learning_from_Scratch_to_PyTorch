      "source": [
        "\n",
        "import torch\n",
        "import torch.nn as nn\n",
        "\n",
        "# Input\n",
        "x = torch.tensor([[2.0, 3.0]])\n",
        "\n",
        "# Neural network\n",
        "model = nn.Sequential(\n",
        "    nn.Linear(2, 2),\n",
        "    nn.ReLU(),\n",
        "    nn.Linear(2, 1)\n",
        ")\n",
        "\n",
        "# Forward propagation\n",
        "output = model(x)\n",
        "\n",
        "print(\"Final Output:\", output)\n",
        "\n"
      ]
    }
  ]
}