      "source": [
        "\n",
        "\n",
        "\n",
        "import torch\n",
        "\n",
        "w = torch.tensor(0.0, requires_grad=True)\n",
        "\n",
        "optimizer = torch.optim.SGD([w], lr=0.1)\n",
        "\n",
        "for i in range(10):\n",
        "\n",
        "    loss = (w - 3) ** 2\n",
        "\n",
        "    optimizer.zero_grad()\n",
        "    loss.backward()\n",
        "    optimizer.step()\n",
        "\n",
        "    print(\"Weight:\", w.item(), \"Loss:\", loss.item())\n"
      ]
    }
  ]
